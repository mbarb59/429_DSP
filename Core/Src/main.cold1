#include "stm32f429xx.h"

#include "uart.h"
#include "f429_sdram.h"
#include "ltdc_ili9341.h"



int main(void)
{
    HAL_Init();

    //SystemClock_Config();

    UART_Init();

SystemCoreClockUpdate();

UART_SendString("CORE=");
UART_SendHex32(SystemCoreClock);
UART_SendString("\r\n");

UART_SendString("A");
UART_SendChar('1');
UART_SendChar('2');
UART_SendChar('3');
UART_SendChar('4');
UART_SendChar('5');
UART_SendChar('6');
UART_SendChar('7');
UART_SendChar('8');
UART_SendString("\r\n");

UART_SendString("SYSCLK=");
UART_SendHex32(HAL_RCC_GetSysClockFreq());
UART_SendString("\r\n");

UART_SendString("HCLK=");
UART_SendHex32(HAL_RCC_GetHCLKFreq());
UART_SendString("\r\n");

UART_SendString("PCLK1=");
UART_SendHex32(HAL_RCC_GetPCLK1Freq());
UART_SendString("\r\n");

UART_SendString("PCLK2=");
UART_SendHex32(HAL_RCC_GetPCLK2Freq());
UART_SendString("\r\n");
    
}
    


   